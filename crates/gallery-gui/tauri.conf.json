{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gallery",
  "version": "0.1.0",
  "identifier": "io.github.grigorii-horos.gallery",
  "build": {
    "beforeDevCommand": "pnpm -C ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm -C ui build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gallery",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost",
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Photography",
    "shortDescription": "Media organizer: scan, plan, apply",
    "longDescription": "Gallery scans photo and video folders, plans renames and re-encodes by rules, and applies them with undo.",
    "publisher": "Grigorii Horos",
    "copyright": "MIT License",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "ffmpeg",
          "libimage-exiftool-perl",
          "libavif-bin",
          "imagemagick"
        ],
        "section": "graphics"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
